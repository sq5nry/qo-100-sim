- name: ref_ctl
  id: snippet
  parameters:
    alias: ''
    code: "# External 10 MHz reference (GPSDO on the B200 REF input):\n# checkbox\
      \ to switch internal/external at run time + lock status.\nfrom PyQt5 import\
      \ Qt as _Qt\n_ref_box = _Qt.QCheckBox(\"External 10 MHz ref (GPSDO)\")\n_ref_lbl\
      \ = _Qt.QLabel(\"Ref: ?\")\n_row = _Qt.QHBoxLayout()\n_row.addWidget(_ref_box)\n\
      _row.addWidget(_ref_lbl)\n_row.addStretch(1)\nself.top_layout.addLayout(_row)\n\
      \ndef _ref_set(on):\n    src = \"external\" if on else \"internal\"\n    try:\n\
      \        self.usrp_tx.set_clock_source(src, 0)\n        print(\"[ref] clock\
      \ source ->\", src)\n    except Exception as e:\n        print(\"[ref] set_clock_source\
      \ failed:\", e)\n    _ref_poll()\n\ndef _ref_poll():\n    try:\n        src\
      \ = self.usrp_tx.get_clock_source(0)\n    except Exception:\n        src = \"\
      ?\"\n    if src != \"external\":\n        _ref_lbl.setText(\"Ref: internal TCXO\"\
      )\n        _ref_lbl.setStyleSheet(\"color: gray\")\n        return\n    try:\n\
      \        locked = self.usrp_tx.get_mboard_sensor(\"ref_locked\", 0).to_bool()\n\
      \    except Exception:\n        locked = None\n    if locked:\n        _ref_lbl.setText(\"\
      Ref: external 10 MHz - LOCKED\")\n        _ref_lbl.setStyleSheet(\"color: green;\
      \ font-weight: bold\")\n    else:\n        _ref_lbl.setText(\"Ref: external\
      \ 10 MHz - NOT LOCKED\")\n        _ref_lbl.setStyleSheet(\"color: red; font-weight:\
      \ bold\")\n\ntry:\n    _ref_box.setChecked(self.usrp_tx.get_clock_source(0)\
      \ == \"external\")\nexcept Exception:\n    pass\n_ref_box.toggled.connect(_ref_set)\n\
      self._ref_timer = _Qt.QTimer()\nself._ref_timer.timeout.connect(_ref_poll)\n\
      self._ref_timer.start(1000)\n_ref_poll()"
    comment: External 10 MHz reference toggle + lock indicator
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 36.0]
    rotation: 0
    state: enabled
