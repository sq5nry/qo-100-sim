- name: leila_ctl
  id: snippet
  parameters:
    alias: ''
    code: "# LEILA-style policing of the transponder path:\n#  - finds received signals\
      \ whose power in a 2.7 kHz slot exceeds leila_thresh_dbfs\n#  - marker: puts\
      \ a two-tone siren on top of up to 3 offenders\n#  - limiter: attenuates only\
      \ the offending slots down to threshold + leila_limit_db\n# Detection is done\
      \ before the limiter (feed-forward), a few times per second.\nimport numpy as\
      \ _np\nfrom PyQt5 import Qt as _QQt\n_le_mark_box = _QQt.QCheckBox(\"LEILA marker\"\
      )\n_le_lim_box = _QQt.QCheckBox(\"LEILA limiter\")\n_le_mark_box.setChecked(True)\n\
      _le_lim_box.setChecked(True)\n_le_lbl = _QQt.QLabel(\"LEILA: starting\")\n_le_row\
      \ = _QQt.QHBoxLayout()\nfor _w in (_le_mark_box, _le_lim_box, _le_lbl):\n  \
      \  _le_row.addWidget(_w)\n_le_row.addStretch(1)\nself.top_layout.addLayout(_le_row)\n\
      \n_LE_TAPS = 1024       # limiter filter length (fixed delay of 512 samples)\n\
      _LE_SLOT = 9          # bins summed for one signal slot (about 2.7 kHz)\n_LE_HOLD\
      \ = 8          # frames of peak hold (about 0.4 s)\n_LE_GUARD = 16        #\
      \ bins blanked around a found signal (about +-5 kHz)\n_LE_RELEASE = 10 ** (1.0\
      \ / 20)   # limiter recovery per tick: 1 dB\n_le = {\"hist\": [], \"gain\":\
      \ None, \"last\": None, \"tick\": 0, \"ident\": True}\n_le_marks = (self.leila_mark0,\
      \ self.leila_mark1, self.leila_mark2)\n_le_win_taps = _np.hamming(_LE_TAPS)\n\
      \ndef _le_identity():\n    if not _le[\"ident\"]:\n        taps = [0j] * _LE_TAPS\n\
      \        taps[_LE_TAPS // 2] = 1 + 0j\n        self.leila_filter.set_taps(taps)\n\
      \        _le[\"ident\"] = True\n        _le[\"last\"] = None\n    _le[\"gain\"\
      ] = None\n\ndef _le_tick():\n    try:\n        x = _np.asarray(self.leila_probe.level(),\
      \ dtype=_np.complex64)\n        n = len(x)\n        fs = float(self.samp_rate)\n\
      \        thr_db = float(self.leila_thresh_dbfs)\n        lim_db = thr_db + float(self.leila_limit_db)\n\
      \        mark_amp = 10 ** (float(self.leila_marker_dbfs) / 20.0)\n    except\
      \ Exception:\n        return\n    if n < 64 or n % 2:\n        return\n    _le[\"\
      tick\"] += 1\n    w = _np.hanning(n)\n    p = _np.abs(_np.fft.fftshift(_np.fft.fft(x\
      \ * w))) ** 2 / (n * _np.sum(w * w))\n    slot = _np.convolve(p, _np.ones(_LE_SLOT),\
      \ \"same\")\n    hist = _le[\"hist\"]\n    hist.append(slot)\n    del hist[:-_LE_HOLD]\n\
      \    held = _np.max(hist, axis=0)\n\n    thr = 10 ** (thr_db / 10.0)\n    work\
      \ = held.copy()\n    found = []\n    for _ in range(len(_le_marks)):\n     \
      \   k = int(_np.argmax(work))\n        if work[k] <= thr:\n            break\n\
      \        found.append(((k - n / 2.0) * fs / n, 10 * _np.log10(work[k] / thr)))\n\
      \        work[max(0, k - _LE_GUARD):k + _LE_GUARD + 1] = 0.0\n\n    siren =\
      \ 300.0 if (_le[\"tick\"] // 4) % 2 else -300.0\n    for i, src in enumerate(_le_marks):\n\
      \        if _le_mark_box.isChecked() and i < len(found):\n            src.set_frequency(found[i][0]\
      \ + siren)\n            src.set_amplitude(mark_amp)\n        else:\n       \
      \     src.set_amplitude(0.0)\n\n    reduction = 0.0\n    if _le_lim_box.isChecked():\n\
      \        lim = 10 ** (lim_db / 10.0)\n        target = _np.where(held > lim,\
      \ _np.sqrt(lim / _np.maximum(held, 1e-20)), 1.0)\n        target = _np.minimum.reduce([_np.roll(target,\
      \ s) for s in range(-4, 5)])\n        prev = _le[\"gain\"]\n        gain = target\
      \ if prev is None or len(prev) != n else _np.minimum(target, _np.minimum(prev\
      \ * _LE_RELEASE, 1.0))\n        _le[\"gain\"] = gain\n        reduction = -20\
      \ * _np.log10(max(float(gain.min()), 1e-6))\n        if reduction < 0.05:\n\
      \            _le_identity()\n        else:\n            g = gain.reshape(_LE_TAPS,\
      \ n // _LE_TAPS).min(axis=1)\n            last = _le[\"last\"]\n           \
      \ if last is None or _np.max(_np.abs(g - last)) > 0.02:\n                h =\
      \ _np.fft.fftshift(_np.fft.ifft(_np.fft.ifftshift(g))) * _le_win_taps\n    \
      \            self.leila_filter.set_taps([complex(v) for v in h])\n         \
      \       _le[\"last\"] = g\n                _le[\"ident\"] = False\n    else:\n\
      \        _le_identity()\n\n    if found:\n        f0, over = max(found, key=lambda\
      \ t: t[1])\n        txt = \"LEILA: %d signal(s) over limit, worst +%.1f dB at\
      \ %+.1f kHz (%.4f MHz)\" % (\n            len(found), over, f0 / 1e3, (float(self.tx_center)\
      \ + f0) / 1e6)\n        if reduction > 0.05:\n            txt += \", limiting\
      \ %.1f dB\" % reduction\n        if not (_le_mark_box.isChecked() or _le_lim_box.isChecked()):\n\
      \            txt += \" (monitoring only)\"\n        _le_lbl.setText(txt)\n \
      \       _le_lbl.setStyleSheet(\"color: black; background: orange; font-weight:\
      \ bold; padding: 2px\")\n    else:\n        _le_lbl.setText(\"LEILA: no signal\
      \ over %.1f dBFS\" % thr_db)\n        _le_lbl.setStyleSheet(\"color: green;\
      \ padding: 2px\")\n\nself._leila_timer = _QQt.QTimer()\nself._leila_timer.timeout.connect(_le_tick)\n\
      self._leila_timer.start(50)"
    comment: LEILA-style per-signal marker and limiter
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2144, 1324.0]
    rotation: 0
    state: enabled
