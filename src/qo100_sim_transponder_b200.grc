- name: level_ctl
  id: snippet
  parameters:
    alias: ''
    code: "# Drive-level indication: RX in-band peak and TX (DAC) drive peak/RMS in\
      \ dBFS,\n# with a 3 s peak hold, colour warning and an overdrive event counter.\n\
      import math as _math, time as _time\nfrom PyQt5 import Qt as _LQt\n_lv_rx =\
      \ _LQt.QLabel(\"RX peak: ?\")\n_lv_tx = _LQt.QLabel(\"TX drive: ?\")\n_lv_cnt\
      \ = _LQt.QLabel(\"Overdrive events: 0\")\n_lv_rst = _LQt.QPushButton(\"Reset\"\
      )\n_lv_row = _LQt.QHBoxLayout()\nfor _w in (_lv_rx, _lv_tx, _lv_cnt, _lv_rst):\n\
      \    _lv_row.addWidget(_w)\n_lv_row.addStretch(1)\nself.top_layout.addLayout(_lv_row)\n\
      _lv = {\"rx\": [], \"tx\": [], \"events\": 0, \"tx_red\": False, \"rx_red\"\
      : False}\n_LV_HOLD_S = 3.0\n\ndef _lv_db(p):\n    return 10.0 * _math.log10(p)\
      \ if p > 1e-12 else -120.0\n\ndef _lv_style(lbl, text, level, warn, clip):\n\
      \    if level >= clip:\n        lbl.setStyleSheet(\"color: white; background:\
      \ red; font-weight: bold; padding: 2px\")\n        text += \"  OVERDRIVE\"\n\
      \    elif level >= warn:\n        lbl.setStyleSheet(\"color: black; background:\
      \ orange; font-weight: bold; padding: 2px\")\n        text += \"  high\"\n \
      \   else:\n        lbl.setStyleSheet(\"color: green; padding: 2px\")\n    lbl.setText(text)\n\
      \ndef _lv_held(key, value):\n    now = _time.time()\n    hist = _lv[key]\n \
      \   hist.append((now, value))\n    while hist and now - hist[0][0] > _LV_HOLD_S:\n\
      \        hist.pop(0)\n    return max(v for _, v in hist)\n\ndef _lv_poll():\n\
      \    try:\n        rx = _lv_db(self.rx_peak_probe.level())\n        tx = _lv_db(self.tx_peak_probe.level())\n\
      \        tx_rms = _lv_db(self.tx_rms_probe.level())\n    except Exception:\n\
      \        return\n    rx_h = _lv_held(\"rx\", rx)\n    tx_h = _lv_held(\"tx\"\
      , tx)\n    _lv_style(_lv_rx, \"RX peak: %6.1f dBFS (3 s max %6.1f)\" % (rx,\
      \ rx_h),\n              rx_h, self.rx_warn_dbfs, self.rx_clip_dbfs)\n    _lv_style(_lv_tx,\
      \ \"TX drive peak: %6.1f dBFS, RMS %6.1f (3 s max %6.1f)\" % (tx, tx_rms, tx_h),\n\
      \              tx_h, self.tx_warn_dbfs, self.tx_clip_dbfs)\n    for key, level,\
      \ clip, name in ((\"tx_red\", tx, self.tx_clip_dbfs, \"TX drive\"),\n      \
      \                             (\"rx_red\", rx, self.rx_clip_dbfs, \"RX input\"\
      )):\n        red = level >= clip\n        if red and not _lv[key]:\n       \
      \     _lv[\"events\"] += 1\n            print(\"[level] %s overdrive: %.1f dBFS\
      \ peak\" % (name, level))\n        _lv[key] = red\n    _lv_cnt.setText(\"Overdrive\
      \ events: %d\" % _lv[\"events\"])\n\ndef _lv_reset():\n    _lv[\"events\"] =\
      \ 0\n    _lv[\"rx\"].clear()\n    _lv[\"tx\"].clear()\n\n_lv_rst.clicked.connect(_lv_reset)\n\
      self._lv_timer = _LQt.QTimer()\nself._lv_timer.timeout.connect(_lv_poll)\nself._lv_timer.start(100)\n"
    comment: RX/TX drive level indicator with overdrive warning
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 36.0]
    rotation: 0
    state: enabled
